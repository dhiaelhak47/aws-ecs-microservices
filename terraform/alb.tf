resource "aws_lb_target_group" "notifications_service" {
  name        = "${local.name_prefix}-notif-tg"
  port        = 3003
  protocol    = "HTTP"
  vpc_id      = aws_vpc.main.id
  target_type = "ip"

  health_check {
    enabled             = true
    path                = "/health"
